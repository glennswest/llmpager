[Unit]
Description=llmpager OpenAI-compatible MoE paging server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=glenn
ExecStart=/home/glenn/llmpager/target/release/llmpager-serve \
  --config=/home/glenn/llmpager/deploy/serve.json
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
